<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/calculator_bg" android:orientation="vertical" android:padding="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="100dp" android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp">
        <TextView android:id="@+id/tvIntput" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="end|bottom" android:textColor="#263C1C" android:textSize="14sp" android:maxLines="2" />
        <TextView android:id="@+id/tvResult" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="end|center_vertical" android:textColor="#263C1C" android:textSize="24sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="start" android:accessibilityLiveRegion="polite" />
    </LinearLayout>
    <GridLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:columnCount="4" android:rowCount="5">
        <ImageButton android:id="@+id/btnAllCRL" android:layout_width="0dp" android:layout_height="48dp" android:layout_row="0" android:layout_column="0" android:layout_columnWeight="1" android:layout_gravity="fill_horizontal" android:layout_margin="4dp" android:background="@android:color/transparent" android:scaleType="fitXY" android:tag="AC" android:contentDescription="@string/calculator_all_clear" app:srcCompat="@drawable/sign_allclear" />
        <ImageButton android:id="@+id/btnCRL" android:layout_width="0dp" android:layout_height="48dp" android:layout_row="0" android:layout_column="1" android:layout_columnWeight="1" android:layout_gravity="fill_horizontal" android:layout_margin="4dp" android:background="@android:color/transparent" android:scaleType="fitXY" android:tag="C" android:contentDescription="@string/calculator_clear" app:srcCompat="@drawable/sign_clear" />
        <ImageButton android:id="@+id/btnMultiply" android:layout_width="0dp" android:layout_height="48dp" android:layout_row="0" android:layout_column="2" android:layout_columnWeight="1" android:layout_gravity="fill_horizontal" android:layout_margin="4dp" android:background="@android:color/transparent" android:scaleType="fitXY" android:tag="x" android:contentDescription="@string/calculator_multiply" app:srcCompat="@drawable/op_multiply" />
        <ImageButton android:id="@+id/btnDivide" android:layout_width="0dp" android:layout_height="48dp" android:layout_row="0" android:layout_column="3" android:layout_columnWeight="1" android:layout_gravity="fill_horizontal" android:layout_margin="4dp" android:background="@android:color/transparent" android:scaleType="fitXY" android:tag="÷" android:contentDescription="@string/calculator_divide" app:srcCompat="@drawable/op_divide" />
        <ImageButton android:id="@+id/btnSeven" android:layout_width="0dp" android:layout_height="48dp" android:layout_row="1" android:layout_column="0" android:layout_columnWeight="1" android:layout_gravity="fill_horizontal" android:layout_margin="4dp" android:background="@android:color/transparent" android:scaleType="fitXY" android:tag="7" android:contentDescription="@string/calculator_digit_7" app:srcCompat="@drawable/num7" />
        <ImageButton android:id="@+id/btnEight" android:layout_width="0dp" android:layout_height="48dp" android:layout_row="1" android:layout_column="1" android:layout_columnWeight="1" android:layout_gravity="fill_horizontal" android:layout_margin="4dp" android:background="@android:color/transparent" android:scaleType="fitXY" android:tag="8" android:contentDescription="@string/calculator_digit_8" app:srcCompat="@drawable/num8" />
        <ImageButton android:id="@+id/btnNine" android:layout_width="0dp" android:layout_height="48dp" android:layout_row="1" android:layout_column="2" android:layout_columnWeight="1" android:layout_gravity="fill_horizontal" android:layout_margin="4dp" android:background="@android:color/transparent" android:scaleType="fitXY" android:tag="9" android:contentDescription="@string/calculator_digit_9" app:srcCompat="@drawable/num9" />
        <ImageButton android:id="@+id/btnSubtract" android:layout_width="0dp" android:layout_height="48dp" android:layout_row="1" android:layout_column="3" android:layout_columnWeight="1" android:layout_gravity="fill_horizontal" android:layout_margin="4dp" android:background="@android:color/transparent" android:scaleType="fitXY" android:tag="-" android:contentDescription="@string/calculator_subtract" app:srcCompat="@drawable/op_subtract" />
        <ImageButton android:id="@+id/btnFour" android:layout_width="0dp" android:layout_height="48dp" android:layout_row="2" android:layout_column="0" android:layout_columnWeight="1" android:layout_gravity="fill_horizontal" android:layout_margin="4dp" android:background="@android:color/transparent" android:scaleType="fitXY" android:tag="4" android:contentDescription="@string/calculator_digit_4" app:srcCompat="@drawable/num4" />
        <ImageButton android:id="@+id/btnFive" android:layout_width="0dp" android:layout_height="48dp" android:layout_row="2" android:layout_column="1" android:layout_columnWeight="1" android:layout_gravity="fill_horizontal" android:layout_margin="4dp" android:background="@android:color/transparent" android:scaleType="fitXY" android:tag="5" android:contentDescription="@string/calculator_digit_5" app:srcCompat="@drawable/num5" />
        <ImageButton android:id="@+id/btnSix" android:layout_width="0dp" android:layout_height="48dp" android:layout_row="2" android:layout_column="2" android:layout_columnWeight="1" android:layout_gravity="fill_horizontal" android:layout_margin="4dp" android:background="@android:color/transparent" android:scaleType="fitXY" android:tag="6" android:contentDescription="@string/calculator_digit_6" app:srcCompat="@drawable/num6" />
        <ImageButton android:id="@+id/btnPlus" android:layout_width="0dp" android:layout_height="48dp" android:layout_row="2" android:layout_column="3" android:layout_columnWeight="1" android:layout_gravity="fill_horizontal" android:layout_margin="4dp" android:background="@android:color/transparent" android:scaleType="fitXY" android:tag="+" android:contentDescription="@string/calculator_plus" app:srcCompat="@drawable/op_plus" />
        <ImageButton android:id="@+id/btnOne" android:layout_width="0dp" android:layout_height="48dp" android:layout_row="3" android:layout_column="0" android:layout_columnWeight="1" android:layout_gravity="fill_horizontal" android:layout_margin="4dp" android:background="@android:color/transparent" android:scaleType="fitXY" android:tag="1" android:contentDescription="@string/calculator_digit_1" app:srcCompat="@drawable/num1" />
        <ImageButton android:id="@+id/btnTwo" android:layout_width="0dp" android:layout_height="48dp" android:layout_row="3" android:layout_column="1" android:layout_columnWeight="1" android:layout_gravity="fill_horizontal" android:layout_margin="4dp" android:background="@android:color/transparent" android:scaleType="fitXY" android:tag="2" android:contentDescription="@string/calculator_digit_2" app:srcCompat="@drawable/num2" />
        <ImageButton android:id="@+id/btnThree" android:layout_width="0dp" android:layout_height="48dp" android:layout_row="3" android:layout_column="2" android:layout_columnWeight="1" android:layout_gravity="fill_horizontal" android:layout_margin="4dp" android:background="@android:color/transparent" android:scaleType="fitXY" android:tag="3" android:contentDescription="@string/calculator_digit_3" app:srcCompat="@drawable/num3" />
        <ImageButton android:id="@+id/btnEqual" android:layout_width="0dp" android:layout_height="104dp" android:layout_row="3" android:layout_column="3" android:layout_columnWeight="1" android:layout_gravity="fill_horizontal" android:layout_margin="4dp" android:background="@android:color/transparent" android:scaleType="fitXY" android:tag="=" android:contentDescription="@string/calculator_equal" app:srcCompat="@drawable/op_equal" android:layout_rowSpan="2" />
        <ImageButton android:id="@+id/btnBack" android:layout_width="0dp" android:layout_height="48dp" android:layout_row="4" android:layout_column="0" android:layout_columnWeight="1" android:layout_gravity="fill_horizontal" android:layout_margin="4dp" android:background="@android:color/transparent" android:scaleType="fitXY" android:tag="⬅" android:contentDescription="@string/calculator_backspace" app:srcCompat="@drawable/sign_back" />
        <ImageButton android:id="@+id/btnZero" android:layout_width="0dp" android:layout_height="48dp" android:layout_row="4" android:layout_column="1" android:layout_columnWeight="1" android:layout_gravity="fill_horizontal" android:layout_margin="4dp" android:background="@android:color/transparent" android:scaleType="fitXY" android:tag="0" android:contentDescription="@string/calculator_digit_0" app:srcCompat="@drawable/num0" />
        <ImageButton android:id="@+id/btnDot" android:layout_width="0dp" android:layout_height="48dp" android:layout_row="4" android:layout_column="2" android:layout_columnWeight="1" android:layout_gravity="fill_horizontal" android:layout_margin="4dp" android:background="@android:color/transparent" android:scaleType="fitXY" android:tag="." android:contentDescription="@string/calculator_dot" app:srcCompat="@drawable/dot" />
    </GridLayout>
    <Button android:id="@+id/buttonclose" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:text="@string/close_calculator" android:textColor="#FFFFFF" android:textSize="18sp" app:backgroundTint="#F06292" />
</LinearLayout>