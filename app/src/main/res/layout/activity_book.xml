<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:id="@+id/book" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#ffffff" android:orientation="vertical" tools:context=".BookActivity">
    <androidx.appcompat.widget.Toolbar android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="56dp" android:background="#48B6B5" android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar" app:popupTheme="@style/ThemeOverlay.AppCompat.Light" app:titleTextColor="#FFFFFF" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="226dp" android:layout_marginTop="0dp" android:background="@drawable/book_bg" android:orientation="horizontal">
                <ImageView android:id="@+id/imageView1" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_weight="1" android:padding="20dp" android:visibility="visible" app:srcCompat="@drawable/books_book1" android:importantForAccessibility="no" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:orientation="vertical">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="10dp">
                    <TextView android:id="@+id/textView1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/book_id_label" android:textStyle="bold" />
                    <TextView android:id="@+id/book_tv01" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="3" android:textAllCaps="true" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="5dp" android:orientation="horizontal" android:padding="10dp">
                    <TextView android:id="@+id/textView2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/book_name_label" android:textStyle="bold" />
                    <TextView android:id="@+id/book_tv02" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="3" android:textColor="#03A9F4" android:textSize="14sp" android:textStyle="bold" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="5dp" android:orientation="horizontal" android:padding="10dp">
                    <TextView android:id="@+id/textView3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/book_price_label" android:textStyle="bold" />
                    <TextView android:id="@+id/book_tv03" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="3" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="5dp" android:orientation="horizontal" android:padding="10dp">
                    <TextView android:id="@+id/textView4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/book_date_label" android:textStyle="bold" />
                    <TextView android:id="@+id/book_tv04" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="3" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="5dp" android:orientation="horizontal" android:padding="10dp">
                    <TextView android:id="@+id/textView5" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/book_writer_label" android:textStyle="bold" />
                    <TextView android:id="@+id/book_tv05" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="3" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="5dp" android:orientation="horizontal" android:padding="10dp">
                    <TextView android:id="@+id/textView6" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/book_description_label" android:textStyle="bold" />
                    <TextView android:id="@+id/book_tv06" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="3" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="10dp">
                    <TextView android:id="@+id/textView7" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/book_category_label" android:textStyle="bold" />
                    <TextView android:id="@+id/book_tv07" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="3" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <Button android:id="@+id/book_bt01" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="장바구니 담기" android:backgroundTint="#FB8C00" />
    <ImageView android:id="@+id/imageView2" android:layout_width="match_parent" android:layout_height="63dp" app:srcCompat="@drawable/menu_bottom" android:importantForAccessibility="no" />
</LinearLayout>